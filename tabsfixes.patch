+  z-index: 100;
   transition: 0.3s;
   text-decoration: underline;
   color: #a0e8f3;
@@ -377,7 +381,6 @@ button:hover {
 .sidenav {
   margin-top: 10px;
   height: auto;
-  width: 0px;
   position: fixed;
   z-index: 500;
   top: 0;
@@ -385,7 +388,6 @@ button:hover {
   background-color: #0b09109f;
   box-shadow: #011d1d 0px 0px 10px 0px;
   overflow-x: hidden;
-  transition: 0.5s;
   /* Extra top padding so the close button / nav links clear the status bar and
