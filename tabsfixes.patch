 #add-extra-info-box,
@@ -3078,6 +3104,7 @@ body.action-open #action-backdrop {
   box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.45);
   transition: max-height 0.34s cubic-bezier(0.22, 1, 0.36, 1),
     opacity 0.24s ease, padding 0.34s cubic-bezier(0.22, 1, 0.36, 1);
