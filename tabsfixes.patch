   animation: modalCardIn 0.34s cubic-bezier(0.22, 1, 0.36, 1);
 }
@@ -1009,30 +1020,49 @@ input {
   align-items: center;
   text-align: center;
   z-index: 0;
-  background-color: rgba(0, 0, 0, 0);
-  transition: backdrop-filter 0.4s ease, background-color 0.4s ease, visibility 0s linear 0.4s;
-  -webkit-backdrop-filter: blur(0px);
-  backdrop-filter: blur(0px);
+  background-color: transparent;
+  transition: visibility 0s linear 0.4s;
   visibility: hidden;
 }
 
-#sideNavModal.active {
+/* The dim + blur lives on a pseudo-element so only its OPACITY animates.
+   Transitioning `backdrop-filter` itself (blur(0) -> blur(8px)) made iOS
