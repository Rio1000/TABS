+  will-change: transform;
   overflow-x: hidden;
 }
 
 #mySidenav.open {
-  width: 250px;
+  transform: translateX(0);
 }
 
 #donate {
@@ -2061,10 +2091,6 @@ body.payments-enabled .pay-request-btn {
